# ================================
# Django Configuration
# ================================
DEBUG=0
SECRET_KEY=generate-a-random-secret-key-here-for-production
ALLOWED_HOSTS=api-loader.claive.uz,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://loader.claive.uz,http://localhost:5173

# Port exposed to host on VPS for NGINX Proxy Manager
API_HOST_PORT=8088

# ================================
# Database (PostgreSQL)
# ================================
POSTGRES_DB=uloader_db
POSTGRES_USER=uloader_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ================================
# Redis & Celery
# ================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ================================
# File Storage & Expiration
# ================================
# Files older than this in minutes will be cleaned up automatically by Celery Beat
FILE_EXPIRATION_MINUTES=60

# ================================
# Optional API Keys
# ================================
# Spotify API credentials (Optional: public metadata extraction works without them, but recommended for high volume)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
